[%General]
author=Gabriel Perko-Engel
comment=A Kvantum theme based on Libadwaita
composite=true
menu_shadow_depth=12
tooltip_shadow_depth=0
x11drag=menubar_and_primary_toolbar
scrollable_menu=true
spread_menuitems=true
combo_menu=true
combo_as_lineedit=true
check_size=24
tickless_slider_handle_size=42
scroll_arrows=false
transient_scrollbar=false
animate_states=true
respect_DE=true
transient_groove=true
slider_width=6
slider_handle_width=42
slider_handle_length=36
progressbar_thickness=12
spread_progressbar=true
spin_button_width=30
vertical_spin_indicators=false
joined_inactive_tabs=true
force_size_grip=0
attach_active_tab=false
center_doc_tabs=true
center_normal_tabs=true
embedded_tabs=false
tab_button_extra_margin=0
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
tree_branch_line=true

[GeneralColors]
# Kvantum 的 polish(QPalette&) 只有一行 palette = standardPalette()，只填这里出现过的角色；
# 漏掉的角色回落到 QPalette 默认构造值（Window = 浅灰），表现为菜单栏/工具栏/页签栏那条浅灰带。
# 四个斜面色拉平成 surface：Libadwaita 是平面设计，浮雕色会让形状语言变成另一套。
window.color={{colors.surface.default.hex}}
window.text.color={{colors.on_surface.default.hex}}
inactive.window.color={{colors.surface.default.hex}}
inactive.window.text.color={{colors.on_surface_variant.default.hex}}
base.color={{colors.overlay_field.default.hex}}
inactive.base.color={{colors.overlay_field.default.hex}}
alt.base.color={{colors.surface_container_low.default.hex}}
inactive.alt.base.color={{colors.surface_container_low.default.hex}}
button.color={{colors.overlay_strong.default.hex}}
button.text.color={{colors.on_surface.default.hex}}
light.color={{colors.surface.default.hex}}
mid.light.color={{colors.surface.default.hex}}
dark.color={{colors.surface.default.hex}}
mid.color={{colors.surface.default.hex}}
highlight.color={{colors.primary.default.hex}}
inactive.highlight.color={{colors.primary.default.hex}}
highlight.text.color={{colors.on_primary.default.hex}}
inactive.highlight.text.color={{colors.on_primary.default.hex}}
tooltip.base.color={{colors.surface_container.default.hex}}
tooltip.text.color={{colors.on_surface.default.hex}}
text.color={{colors.on_surface.default.hex}}
inactive.text.color={{colors.on_surface_variant.default.hex}}
disabled.text.color={{colors.on_surface.default.hex}}61
link.color={{colors.primary.default.hex}}
link.visited.color={{colors.primary.default.hex}}
progress.indicator.text.color={{colors.on_primary.default.hex}}
progress.inactive.indicator.text.color={{colors.on_surface.default.hex}}
shadow.color={{colors.shadow.default.hex}}


[PanelButtonCommand]
frame.top=9
frame.bottom=9
frame.left=9
frame.right=9
interior=true
focusFrame=false
frame=true
frame.element=button
interior.element=button
indicator.size=16
frame.expansion=0

[TitleBar]
frame=false
frame.expansion=0
indicator.size=38
text.margin.top=12
text.margin.bottom=12

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.size=16

[IndicatorArrow]
indicator.element=arrow
indicator.size=16

[DropDownButton]
indicator.element=arrow-down
indicator.size=16

[Focus]
frame.element=focus
frame.patternsize=6
frame=true
frame.expansion=100
frame.top=9
frame.bottom=9
frame.left=9
frame.right=9

[Button]
frame.element=button
interior.element=button
indicator.size=16
focusFrame=false
frame.top=9
frame.bottom=9
frame.left=9
frame.right=9

[PanelButtonTool]
inherits=PanelButtonCommand
indicator.size=16

[MenuBar]
interior.element=titlebar

[MenuBarItem]
interior.element=menubaritem
frame.element=menubaritem
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin.left=3
text.margin.right=3
text.margin.top=0
text.margin.bottom=0

[Toolbar]
frame=true
frame.top=1
frame.bottom=1
frame.left=0
frame.right=0

[ToolbarButton]
inherits=PanelButtonCommand
frame=true
frame.element=button
interior.element=button
frame.top=9
frame.bottom=9
frame.left=9
frame.right=9
indicator.size=16

[LineEdit]
frame.top=9
frame.bottom=9
frame.left=9
frame.right=9
indicator.element=arrow
indicator.size=16

[ToolbarLineEdit]
inherits=LineEdit
indicator.element=arrow
indicator.size=16

[ComboBox]
inherits=LineEdit
frame.top=9
frame.bottom=9
frame.left=9
frame.right=9
indicator.size=16
indicator.element=arrow

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.size=16

[TreeExpander]
frame=false
interior=false
indicator.size=16
indicator.element=indicator

[Menu]
frame.top=12
frame.bottom=12
frame.left=12
frame.right=12
frame.element=menu
interior.element=menu
indicator.size=16

[Slider]
