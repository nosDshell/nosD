frame.element=progress-pattern
interior.element=progress-pattern
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.margin.top=0
text.margin.bottom=0
text.margin.left=3
text.margin.right=3
frame.top=9
frame.bottom=9
frame.left=21
frame.right=21
text.bold=false
frame.expansion=0

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
