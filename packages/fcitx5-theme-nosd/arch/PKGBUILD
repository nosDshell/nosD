# Maintainer: CharOfString <root@charofstring.cc>
pkgname=fcitx5-theme-nosd
pkgver=1.1
pkgrel=1
pkgdesc="nosDshell fcitx5 themes (nosd light/dark)"
arch=('any')
url="https://github.com/nosDshell/nosd"
license=('CC-BY-SA-4.0')
depends=('fcitx5')
source=()
sha256sums=()

package() {
    install -dm755 "$pkgdir/usr/share/fcitx5/themes/"
    cp -r "$startdir/../nosd" "$pkgdir/usr/share/fcitx5/themes/"
    cp -r "$startdir/../nosd-dark" "$pkgdir/usr/share/fcitx5/themes/"
}
